# Unburden local configuration
# Copy to .env and fill in values.

# LLM (Milestone 2+) — xAI / Grok OpenAI-compatible API
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4-1-fast-reasoning

# Backend
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./data/db/unburden.db
UPLOAD_DIR=./data/uploads
SEED_DIR=./data/seed
DEFAULT_PATIENT_ID=patient-raymond-yao

# Optional DeBERTa NLI signal (negation / high-precision support). Keep false
# unless requirements-ml.txt is installed. Does not replace date/numeric math.
USE_NLI_SUPPORT=false
# Optional local fine-tune (after scripts/finetune_deberta_trec.py)
NLI_MODEL_NAME=
# Defaults below match TREC-calibrated file if present; env overrides win.
NLI_CONTRADICTION_MIN=0.45
NLI_CONTRADICTION_MARGIN=0.15
NLI_ENTAILMENT_MIN=0.70

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Chert FaceTime document intake (outbound video → camera frames → PDF)
CHERT_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=
# Verified phone Chert should FaceTime (E.164, e.g. +15551234567)
CHERT_DESTINATION_PHONE=
CHERT_AGENT_NAME=document-intake

# LiveKit Cloud project for BYOR outbound rooms (required to ring)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
